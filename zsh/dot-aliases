# Switch or override terminal/editor theme: theme dark | theme light | theme auto
theme() {
  local mode="$1"
  case "$mode" in
    dark|light)
      export THEME="$mode"
      export TERM_COLORSCHEME="$mode"
      ;;
    auto|system|reset)
      unset THEME
      local sys_mode="light"
      defaults read -g AppleInterfaceStyle &>/dev/null && sys_mode="dark"
      export TERM_COLORSCHEME="$sys_mode"
      mode="auto"
      ;;
    *)
      if [[ -n "$THEME" ]]; then
        echo "Current theme override: $THEME"
      else
        local sys_mode="light"
        defaults read -g AppleInterfaceStyle &>/dev/null && sys_mode="dark"
        echo "Current theme: auto (system is $sys_mode)"
      fi
      echo "Usage: theme [dark|light|auto]"
      return 0
      ;;
  esac

  local branch_color="cyan"
  [[ "${TERM_COLORSCHEME:-dark}" == "light" ]] && branch_color="blue"
  zstyle :prompt:pure:git:branch color "$branch_color"
  prompt_pure_git_branch_color="$branch_color"
  printf "\033]1337;SetUserVar=THEME=%s\007" "$(printf "%s" "$mode" | base64)"

  if [[ "$mode" == "auto" ]]; then
    echo "Theme reset to auto (follows macOS appearance: $TERM_COLORSCHEME)"
  else
    echo "Theme set to $mode (propagated to session, Neovim, and Git Delta)"
  fi
}

# Toggle or set macOS appearance and sync terminal session immediately
appearance() {
  command appearance "$@"
  if [[ -z "$THEME" ]]; then
    theme auto
  else
    local sys_mode="light"
    defaults read -g AppleInterfaceStyle &>/dev/null && sys_mode="dark"
    theme "$sys_mode"
  fi
}

claude() {
  if (( $+commands[jq] )); then
    local mode="${THEME:-}"
    if [[ -z "$mode" ]]; then
      mode="light"
      defaults read -g AppleInterfaceStyle &>/dev/null && mode="dark"
    fi

    local cfg=~/.claude.json
    local current=$(jq -r '.theme // ""' "$cfg" 2>/dev/null)
    if [[ "$current" != "$mode" ]]; then
      jq --arg t "$mode" '.theme = $t' "$cfg" > "${cfg}.tmp" && mv "${cfg}.tmp" "$cfg"
    fi
  fi

  command claude "$@"
}

heic_to_jpg() {
  local extension="${2##*.}"
  if [[ "$extension" != "jpg" && "$extension" != "jpeg" ]]; then
    echo "Error: destination extension must be 'jpg' or 'jpeg'"
  else
    sips -s format jpeg "$1" --out "$2"
  fi
}

mov2mp4() {
    local has_audio
    has_audio=$(ffprobe -i "$1" -show_streams -select_streams a -loglevel quiet | head -1)
    local filters=''
    local args=(-i "$1" -c:v libx264 -preset medium -crf 23 -map_metadata -1 -movflags +faststart)
    if [[ -n "$has_audio" ]]; then
        args+=(-c:a aac -b:a 192k -async 1)
    else
        args+=(-an)
    fi
    if [[ "$2" == "-f" ]]; then
        local speedup_factor=$3
        local scale=$(bc <<< "scale=2; 1/$speedup_factor")
        if [[ -n "$has_audio" ]]; then
            filters='[0:v]setpts='"$scale"'*PTS[v];[0:a]atempo='"$speedup_factor"'[a]'
        else
            filters='setpts='"$scale"'*PTS'
        fi
    fi
    if [[ -n "$filters" && -n "$has_audio" ]]; then
        args+=(-filter_complex "$filters" -map "[v]" -map "[a]")
    elif [[ -n "$filters" ]]; then
        args+=(-filter:v "$filters")
    fi
    ffmpeg "${args[@]}" "${1:r}.mp4"
}

# Manage git worktrees rooted at .worktrees/<name>.
# Usage:
#   gw                      Jump to an existing worktree via fzf
#   gw add <name> [base]    Create branch and worktree at .worktrees/<name>, link .env, and cd in
#   gw rm [name]            Remove worktree; opens fzf selection when name is omitted
#   gw ls                   List active worktrees
gw() {
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "gw: fatal: not a git repository" >&2
    return 1
  }

  case "${1:-}" in
    add)
      local name="$2" base="${3:-HEAD}"
      if [[ -z "$name" ]]; then
        echo "Usage: gw add <name> [base]" >&2
        return 1
      fi

      local wt_dir="$root/.worktrees/$name"

      # Verify repository ignores the worktrees directory
      if ! git check-ignore -q .worktrees/ 2>/dev/null; then
        echo "gw: warning: .worktrees/ is not in .gitignore" >&2
      fi

      git worktree add -b "$name" "$wt_dir" "$base" || return 1

      # Link environment files from primary root when present
      local env_file
      for env_file in .env .env.local; do
        if [[ -f "$root/$env_file" && ! -e "$wt_dir/$env_file" ]]; then
          ln -s "$root/$env_file" "$wt_dir/$env_file"
        fi
      done

      cd "$wt_dir" || return 1
      ;;

    rm)
      local target="$2"
      if [[ -z "$target" ]]; then
        # Exclude primary checkout from removal list
        target=$(git worktree list --porcelain | awk '/^worktree / {print $2}' | grep '/\.worktrees/' | fzf --prompt="Remove worktree: ")
      fi

      if [[ -n "$target" ]]; then
        # Resolve target to path if given by branch name
        [[ -d "$root/.worktrees/$target" ]] && target="$root/.worktrees/$target"
        git worktree remove "$target"
      fi
      ;;

    ls)
      git worktree list
      ;;

    *)
      # Select and jump to worktree
      local dir
      dir=$(git worktree list --porcelain | awk '/^worktree / {print $2}' | fzf --prompt="Jump to worktree: ")
      if [[ -n "$dir" ]]; then
        cd "$dir" || return 1
      fi
      ;;
  esac
}

