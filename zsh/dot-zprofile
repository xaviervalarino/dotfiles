# Deduplicate PATH entries automatically
typeset -U path PATH

# Homebrew
if [ "$(uname -m)" = "arm64" ]; then
  brew=/opt/homebrew/bin/brew
else
  brew=/usr/local/bin/brew
fi
eval "$($brew shellenv)"

path+=(/usr/local/sbin)

# prepend to override system binaries
path=("$HOME/.local/bin" $path) 

# Personal binaries and scripts
path+=("$HOME/scripts")
