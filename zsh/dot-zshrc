#!/usr/bin/env zsh

 typeset -U fpath

[[ -d "$HOMEBREW_PREFIX/share/zsh/site-functions" ]] && fpath+=( "$HOMEBREW_PREFIX/share/zsh/site-functions" )

[[ -d "$HOME/.docker/completions" ]] && fpath+=( "$HOME/.docker/completions" )

# Autoload custom functions from XDG config directory
# Glob qualifiers: 'N' enables nullglob (avoids error if empty), ':t' takes the basename
fpath+=( "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/functions" )
autoload -Uz "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/functions"/*(N:t)

#------------------------------------------
# Activate zsh completions
autoload -Uz compinit
[[ -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh" ]] || mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
compinit -u -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/compdump"

#------------------------------------------
# Aliases: some aliases require `compinit` to be loaded
source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/aliases"

#------------------------------------------
# History
## Set history size
HISTSIZE=10000
## Save history after logout
SAVEHIST=10000
## History file
HISTFILE="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/history"
[[ -d "${HISTFILE:h}" ]] || mkdir -p "${HISTFILE:h}"
## Append into history file
setopt INC_APPEND_HISTORY
## Save only one command if 2 common are same and consistent
setopt HIST_IGNORE_DUPS
## Add timestamp for each entry
setopt EXTENDED_HISTORY   

#------------------------------------------
# Remember recent directories with `cdr`
## https://jlk.fjfi.cvut.cz/arch/manpages/man/zshcontrib.0#REMEMBERING_RECENT_DIRECTORIES
autoload -Uz chpwd_recent_dirs cdr add-zsh-hook
add-zsh-hook chpwd chpwd_recent_dirs

# Freeze terminal modes so Zsh natively restores settings if external commands corrupt them
ttyctl -f 2>/dev/null
## Add arg completion as menu (requires `compinit` to be run)
zstyle ':completion:*' menu selection

#------------------------------------------
# Prompt
autoload -Uz promptinit
promptinit
PURE_PROMPT_SYMBOL='〉'
zstyle :prompt:pure:git:branch color cyan
prompt pure

# Fix for $EDITOR -- set zsh to use emacs style
# keyboard mappings for command-line editing
# e.g., <CTRL+P> to go back in history
bindkey -e

# Make key commands like <CTRL+W> delete just the directory, not the whole line 
WORDCHARS='*?_-.[]~=&;!#$%^(){}<>'

#------------------------------------------
# Init command-line fuzzy finder
## https://github.com/junegunn/fzf
if command -v fzf &> /dev/null; then
  source <(fzf --zsh)
  if [ -f "$HOME/.fzf-git.zsh" ]; then
    source "$HOME/.fzf-git.zsh"
  elif [ -f "${0:a:h}/dot-fzf-git.zsh" ]; then
    source "${0:a:h}/dot-fzf-git.zsh"
  fi
fi

# mise (runtime executor & version manager)
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi


# direnv
if command -v direnv &> /dev/null; then
  eval "$(direnv hook zsh)"
fi

# zoxide (smart cd: use 'z <dir>')
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

# Sync WezTerm & Git Delta color schemes
if [[ -z "$COLOR_MODE" ]]; then
  defaults read -g AppleInterfaceStyle &>/dev/null && export COLOR_MODE="dark" || export COLOR_MODE="light"
fi
if [[ -z "$BAT_THEME" ]]; then
  [[ "$COLOR_MODE" == "light" ]] && export BAT_THEME="GitHub Light" || export BAT_THEME="GitHub Dark"
fi
