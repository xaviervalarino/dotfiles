[user]
  name = Xavier Valarino
  username = xaviervalarino
  email = xvalarino@gmail.com
[alias]
  br = branch
  com = commit
  co = checkout
  st = status --branch
  up = rebase
  ri = rebase --interactive
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  patch = add --patch
  ammend = commit --amend
  amend = commit --amend
  cached = diff --cached
  diff-side = -c delta.side-by-side=true diff
  unstage = reset HEAD --
  last = log -1 HEAD
  prune-merged = "!git for-each-ref --format='%(refname:short)' refs/heads/ | grep -v -E '^(main|master)$' | xargs -P 8 -n 1 -I {} sh -c 'if [ \"$(gh pr view \"$1\" --json state --jq .state 2>/dev/null)\" = \"MERGED\" ]; then git branch -D \"$1\"; fi' _ {}"
[core]
  editor = nvim
  excludesfile = ~/.config/git/excludes
  pager = delta --features="${COLOR_PALETTE:-github}-${COLOR_MODE:-dark}"
  diffFilter = delta --features="${COLOR_PALETTE:-github}-${COLOR_MODE:-dark}" --color-only

[push]
  default = simple
  autoSetupRemote = true
[status]
  submoduleSummary = true
[pull]
  rebase = true
[fetch]
  prune = true
[interactive]
  diffFilter = delta --features="${COLOR_PALETTE:-github}-${COLOR_MODE:-dark}" --color-only
[delta]
  tabs = 4
  navigate = true  # use n and N to move between diff sections
  line-numbers = true
  hyperlinks = true
  hunk-header-style = file line-number syntax
  pager = less -RFM --mouse

[include]
  path = themes/delta.inc

[merge]
  conflictstyle = zdiff3
[rerere]
  enabled = true
[diff]
  algorithm = histogram
  submodule = log
  colorMoved = default
  colorMovedWS = allow-indentation-change
[init]
  defaultBranch = main
  templatedir = ~/.config/git/template/
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[credential]
  helper = osxkeychain
[credential "https://github.com/xaviervalarino/"]
  username = xaviervalarino
[include]
  path = ~/.gitconfig.local

