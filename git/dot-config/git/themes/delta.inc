[delta "github-dark"]
  minus-style = syntax "#3d1418"
  minus-emph-style = syntax "#67060c"
  plus-style = syntax "#103219"
  plus-emph-style = syntax "#1a5e2a"
  minus-empty-line-marker-style = normal "#3d1418"
  plus-empty-line-marker-style = normal "#103219"
  line-numbers-minus-style = "#f85149"
  line-numbers-plus-style = "#3fb950"
  line-numbers-zero-style = "#6e7681"
  line-numbers-left-style = "#30363d"
  line-numbers-right-style = "#30363d"
  map-styles = "bold purple => syntax dim #1f1728, bold blue => syntax dim #1f1728, bold cyan => syntax dim #111f2a, bold yellow => syntax dim #111f2a"

[delta "github-light"]
  light = true
  minus-style = syntax "#ffebe9"
  minus-emph-style = syntax "#ffc1c0"
  plus-style = syntax "#dafbe1"
  plus-emph-style = syntax "#acf2bd"
  minus-empty-line-marker-style = normal "#ffebe9"
  plus-empty-line-marker-style = normal "#dafbe1"
  line-numbers-minus-style = "#cf222e"
  line-numbers-plus-style = "#1a7f37"
  line-numbers-zero-style = "#8c959f"
  line-numbers-left-style = "#d0d7de"
  line-numbers-right-style = "#d0d7de"
  map-styles = "bold purple => syntax dim #f8f3fc, bold blue => syntax dim #f8f3fc, bold cyan => syntax dim #f1f8fd, bold yellow => syntax dim #f1f8fd"

[delta "rose-pine-dark"]
  minus-style = syntax "#2e202f"
  minus-emph-style = syntax bold "#82435b"
  plus-style = syntax "#1b202f"
  plus-emph-style = syntax bold "#25465a"
  line-numbers-minus-style = "#eb6f92"
  line-numbers-plus-style = "#31748f"
  line-numbers-zero-style = "#6e6a86"
  line-numbers-left-style = "#6e6a86"
  line-numbers-right-style = "#c4a7e7"
  map-styles = "bold purple => syntax dim #2e202f, bold blue => syntax dim #2e202f, bold cyan => syntax dim #1b202f, bold yellow => syntax dim #1b202f"

[delta "rose-pine-light"]
  light = true
  minus-style = syntax "#f3e6e2"
  minus-emph-style = syntax bold "#e5c9cb"
  plus-style = syntax "#e5e6e2"
  plus-emph-style = syntax bold "#bbcacd"
  line-numbers-minus-style = "#b4637a" bold
  line-numbers-plus-style = "#286983" bold
  line-numbers-zero-style = "#9893a5"
  line-numbers-left-style = "#9893a5"
  line-numbers-right-style = "#907aa9"
  map-styles = "bold purple => syntax dim #f3e6e2, bold blue => syntax dim #f3e6e2, bold cyan => syntax dim #e5e6e2, bold yellow => syntax dim #e5e6e2"
