// Zed settings
//
// Defaults: `zed: open default settings` in the command palette.
// Docs: https://zed.dev/docs/configuring-zed
{
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Macchiato",
  },

  // Vim, matched to nvim/dot-config/nvim/init.lua
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 10,
  "soft_wrap": "none",
  // Pending-key popup for <space> and g prefixes, as mini.clue shows in nvim
  "which_key": {
    "enabled": true
  },

  // Saves on buffer switch, like autowriteall, so agent edits on disk
  // rarely collide with unsaved changes in an open buffer
  "autosave": "on_focus_change",
}
