#!/usr/bin/env bash

# Change macOS appearance programmatically
# Usage: appearance [dark|light|toggle]

set -euo pipefail

target="${1:-toggle}"

case "$target" in
  dark) val="true" ;;
  light) val="false" ;;
  toggle|not) val="not dark mode" ;;
  *)
    echo "Usage: appearance [dark|light|toggle]" >&2
    exit 1
    ;;
esac

osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $val"

