#!/usr/bin/env zsh
# Convert MOV/video files to MP4 with optional speedup flag (-f <factor>)
if [[ -z "$1" ]]; then
  echo "Usage: mov2mp4 <input_file> [-f <speedup_factor>]" >&2
  exit 1
fi

has_audio=$(ffprobe -i "$1" -show_streams -select_streams a -loglevel quiet | head -1)
filters=''
args=(-i "$1" -c:v libx264 -preset medium -crf 23 -map_metadata -1 -movflags +faststart)

if [[ -n "$has_audio" ]]; then
  args+=(-c:a aac -b:a 192k -async 1)
else
  args+=(-an)
fi

if [[ "$2" == "-f" && -n "$3" ]]; then
  speedup_factor=$3
  scale=$(bc <<< "scale=2; 1/$speedup_factor")
  if [[ -n "$has_audio" ]]; then
    filters='[0:v]setpts='"$scale"'*PTS[v];[0:a]atempo='"$speedup_factor"'[a]'
  else
    filters='setpts='"$scale"'*PTS'
  fi
fi

if [[ -n "$filters" && -n "$has_audio" ]]; then
  args+=(-filter_complex "$filters" -map "[v]" -map "[a]")
elif [[ -n "$filters" ]]; then
  args+=(-filter:v "$filters")
fi

ffmpeg "${args[@]}" "${1:r}.mp4"
