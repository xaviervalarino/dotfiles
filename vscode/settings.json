{
  "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
  "vscode-neovim.neovimInitVimPaths.darwin": "${userHome}/.config/nvim/init.lua",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "editor.lineNumbers": "relative",
  "editor.cursorSurroundingLines": 10,
  "editor.minimap.enabled": false,
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.5,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "selection",
  "editor.smoothScrolling": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "workbench.startupEditor": "none",
  "git.autofetch": "all",
  "git.autofetchPeriod": 30,
  "git.confirmSync": false,
  "totalTypeScript.hideAllTips": true,
  "workbench.colorTheme": "Rosé Pine",
  "editor.fontSize": 13,
  "js/ts.experimental.useTsgo": true,
  "github.copilot.chat.languageContext.typescript.enabled": false,
  "github.copilot.chat.languageContext.typescript7.enabled": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.pnpm-store/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/coverage/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true
  },
  "search.exclude": {
    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/.next": true,
    "**/.turbo": true
  },
  "search.followSymlinks": false,
  "tailwindCSS.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.hg/**",
    "**/.svn/**",
    "**/.worktrees/**",
    "**/.claude/worktrees/**"
  ],
  "npm.autoDetect": "off",
  "jest.runMode": "on-demand",
  "telemetry.telemetryLevel": "off",
  "workbench.enableExperiments": false,
  "security.workspace.trust.untrustedFiles": "open",
  "editor.fontWeight": "450",
  "diffEditor.renderSideBySide": false,
  "git.blame.editorDecoration.enabled": true
}
